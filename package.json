{
  "name": "rb-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint assets/js/main.js favicon-motion.js",
    "check:links": "node scripts/check-links.mjs",
